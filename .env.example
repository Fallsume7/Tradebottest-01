# MarketWatchBot configuration. Copy to .env (never commit .env).
# Everything here is optional: the default app runs in DEMO mode with no keys.

# --- Data mode: demo | historical | connected ---
MWBOT_DATA_MODE=demo

# --- Persistence ---
MWBOT_DATABASE_URL=sqlite:///./data/mwbot.db
MWBOT_DATA_DIR=./data

# --- Server ---
MWBOT_HOST=127.0.0.1
MWBOT_PORT=8000
MWBOT_LOG_LEVEL=INFO
MWBOT_LOG_JSON=false

# --- Connected data mode (bring your own key; read-only market data) ---
# Massive (formerly Polygon.io). Leave blank to disable.
MWBOT_MASSIVE_API_KEY=
MWBOT_MASSIVE_BASE_URL=https://api.massive.com
# Tell the app how your plan delivers data so the dashboard labels it honestly:
# realtime | delayed. Delayed plans are typically 15 minutes behind.
MWBOT_MASSIVE_FEED=delayed
MWBOT_MASSIVE_DELAY_SECONDS=900

# --- Historical CSV mode ---
MWBOT_HISTORICAL_DIR=./backend/sample_data

# --- Execution safety ---
# paper        : local virtual engine (default, the only fully supported mode)
# mock_browser : Playwright against the bundled mock trading site (testing only)
MWBOT_EXECUTION_MODE=paper
# Hard safety latch. Real-money brokerage execution is NOT implemented and this
# flag is rejected if set to true.
MWBOT_ALLOW_REAL_MONEY=false

# --- Mock browser adapter (local test website only) ---
MWBOT_MOCK_SITE_URL=http://127.0.0.1:8765
MWBOT_MOCK_SITE_USER=demo
MWBOT_MOCK_SITE_PASSWORD=demo
